# Environment Variables Template for Railway
# Copy these to Railway Variables tab (RAW Editor)
# Replace placeholder values with your actual configuration

# ==============================================
# CORE LARAVEL SETTINGS
# ==============================================
APP_NAME="Music Booking System"
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --show
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
# Railway will provide this URL after deployment
APP_URL=https://your-app-name.up.railway.app

# ==============================================
# DATABASE - Railway MySQL
# ==============================================
# Railway automatically creates these when you add MySQL service
# Use variable references to link to MySQL service
DB_CONNECTION=mysql
DB_HOST=${{MYSQL_HOST}}
DB_PORT=${{MYSQL_PORT}}
DB_DATABASE=${{MYSQL_DATABASE}}
DB_USERNAME=${{MYSQL_USER}}
DB_PASSWORD=${{MYSQL_PASSWORD}}

# ==============================================
# SESSION & CACHE
# ==============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ==============================================
# EXTERNAL API INTEGRATION
# ==============================================
# Your existing API for student/user data
EXTERNAL_API_URL=https://your-api-url.com
EXTERNAL_API_CLIENT_ID=your_client_id
EXTERNAL_API_CLIENT_SECRET=your_production_secret

# ==============================================
# MAIL CONFIGURATION (Optional)
# ==============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
# Use app-specific password for Gmail
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# LOGGING
# ==============================================
LOG_CHANNEL=stack
LOG_LEVEL=error

# ==============================================
# BROADCASTING (If needed later)
# ==============================================
BROADCAST_DRIVER=log

# ==============================================
# FILESYSTEM (Railway uses local by default)
# ==============================================
FILESYSTEM_DISK=local

# ==============================================
# SECURITY SETTINGS
# ==============================================
# These are handled by Railway/Laravel automatically
# but listed here for reference
SANCTUM_STATEFUL_DOMAINS=your-app-name.up.railway.app
SESSION_DOMAIN=.your-app-name.up.railway.app

# ==============================================
# OPTIONAL: Redis (if you add Redis service)
# ==============================================
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_HOST=${{REDIS_HOST}}
# REDIS_PORT=${{REDIS_PORT}}
# REDIS_PASSWORD=${{REDIS_PASSWORD}}

# ==============================================
# NOTES:
# ==============================================
# 1. Don't commit this file with real values!
# 2. Generate APP_KEY: php artisan key:generate --show
# 3. Use ${{SERVICE_NAME}} syntax to reference Railway services
# 4. Update APP_URL after Railway assigns your domain
# 5. Rotate all secrets for production (especially EXTERNAL_API_CLIENT_SECRET)
